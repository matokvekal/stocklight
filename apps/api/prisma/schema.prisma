// Prisma schema. The Instrument table is a minimal placeholder to prove the DB wiring.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Instrument {
  id        Int      @id @default(autoincrement())
  symbol    String   @unique
  name      String
  createdAt DateTime @default(now())
}
