{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JeHKwUZynNGADn3ogKdreh","type":"tool_result","content":"1\t// Pure financial calculations. No React, no network, no database.\n2\t// Only a generic helper lives here for now; real analysis comes in later exercises.\n3\t\n4\t/** Percentage change from `from` to `to`. Returns null when `from` is 0. */\n5\texport function percentChange(from: number, to: number): number | null {\n6\t  if (from === 0) return null;\n7\t  return ((to - from) / Math.abs(from)) * 100;\n8\t}\n9\t\n10\t/** Formats a percentage with an explicit sign and two decimals, e.g. \"+1.26%\" or \"-5.00%\". */\n11\texport function formatSignedPercent(value: number): string {\n12\t  const rounded = value.toFixed(2);\n13\t  // A change that rounds to zero carries no sign (avoids \"-0.00%\").\n14\t  if (Number(rounded) === 0) return \"0.00%\";\n15\t  return `${value > 0 ? \"+\" : \"\"}${rounded}%`;\n16\t}\n17\t\n18\t/** Reference market-average price-to-earnings ratio used for the sample stocks. */\n19\texport const MARKET_PE = 20;\n20\t\n21\t/** Formats a number with at most one decimal, dropping a trailing \".0\" (20 -> \"20\", 34.5 -> \"34.5\"). */\n22\tfunction formatPeNumber(value: number): string {\n23\t  return String(Number(value.toFixed(1)));\n24\t}\n25\t\n26\t/**\n27\t * One calm, factual sentence comparing a P/E ratio with the market's.\n28\t * \"Roughly average\" means within ±10% of `marketPe`. A P/E of zero or below means no earnings.\n29\t */\n30\texport function describePe(pe: number, marketPe: number): string {\n31\t  if (!(pe > 0)) {\n32\t    return \"This company has no earnings over the past year, so a P/E ratio does not apply.\";\n33\t  }\n34\t  const market = formatPeNumber(marketPe);\n35\t  const own = formatPeNumber(pe);\n36\t  if (pe > marketPe * 1.1) {\n37\t    return `At ${own}, this stock is more expensive than the market average of ${market}: investors pay more for each dollar of earnings.`;\n38\t  }\n39\t  if (pe < marketPe * 0.9) {\n40\t    return `At ${own}, this stock is cheaper than the market average of ${market}: investors pay less for each dollar of earnings.`;\n41\t  }\n42\t  return `At ${own}, this stock is priced roughly in line with the market average of ${market}.`;\n43\t}\n44\t"}]},"parent_tool_use_id":null,"session_id":"3e6673a1-a413-4bae-a2d3-1d31045a3d80","uuid":"9ce9e5ac-fd44-4f1b-a2a3-d1430f5363ef","timestamp":"2026-10-18T16:35:33.125Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\dev2026\\קורס DDOS AI\\stockLight\\packages\\finance-core\\src\\index.ts","content":"// Pure financial calculations. No React, no network, no database.\n// Only a generic helper lives here for now; real analysis comes in later exercises.\n\n/** Percentage change from `from` to `to`. Returns null when `from` is 0. */\nexport function percentChange(from: number, to: number): number | null {\n  if (from === 0) return null;\n  return ((to - from) / Math.abs(from)) * 100;\n}\n\n/** Formats a percentage with an explicit sign and two decimals, e.g. \"+1.26%\" or \"-5.00%\". */\nexport function formatSignedPercent(value: number): string {\n  const rounded = value.toFixed(2);\n  // A change that rounds to zero carries no sign (avoids \"-0.00%\").\n  if (Number(rounded) === 0) return \"0.00%\";\n  return `${value > 0 ? \"+\" : \"\"}${rounded}%`;\n}\n\n/** Reference market-average price-to-earnings ratio used for the sample stocks. */\nexport const MARKET_PE = 20;\n\n/** Formats a number with at most one decimal, dropping a trailing \".0\" (20 -> \"20\", 34.5 -> \"34.5\"). */\nfunction formatPeNumber(value: number): string {\n  return String(Number(value.toFixed(1)));\n}\n\n/**\n * One calm, factual sentence comparing a P/E ratio with the market's.\n * \"Roughly average\" means within ±10% of `marketPe`. A P/E of zero or below means no earnings.\n */\nexport function describePe(pe: number, marketPe: number): string {\n  if (!(pe > 0)) {\n    return \"This company has no earnings over the past year, so a P/E ratio does not apply.\";\n  }\n  const market = formatPeNumber(marketPe);\n  const own = formatPeNumber(pe);\n  if (pe > marketPe * 1.1) {\n    return `At ${own}, this stock is more expensive than the market average of ${market}: investors pay more for each dollar of earnings.`;\n  }\n  if (pe < marketPe * 0.9) {\n    return `At ${own}, this stock is cheaper than the market average of ${market}: investors pay less for each dollar of earnings.`;\n  }\n  return `At ${own}, this stock is priced roughly in line with the market average of ${market}.`;\n}\n","numLines":44,"startLine":1,"totalLines":44}},"tool_result_meta":[{"id":"toolu_01JeHKwUZynNGADn3ogKdreh","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
