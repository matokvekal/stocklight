{
  "name": "nasdaq-swipe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "S&P 500 Swipe - investment decision support for everyday investors",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/finance-core"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @nasdaq-swipe/web",
    "dev:api": "npm run dev -w @nasdaq-swipe/api",
    "build": "npm run build --workspaces --if-present",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run db:migrate -w @nasdaq-swipe/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "check:worker": "node scripts/worker-check.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:worker"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "cypress": "^16.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prisma": "^6.19.3",
    "start-server-and-test": "^3.0.13",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
